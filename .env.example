# Copy to .env for local secrets. Never commit real values.
EVE_HOME_ASSISTANT_TOKEN=replace-with-a-long-lived-access-token
EVE_LLM_API_KEY=replace-only-if-your-llm-endpoint-requires-authentication
# EVE_CHATTO_BOT_KEY=replace-with-your-chatto-bot-key

# Optional environment overrides for normal settings:
# EVE_HOME_ASSISTANT_URL=http://homeassistant.local:8123
# EVE_LLM_BASE_URL=http://127.0.0.1:1234/v1
# EVE_LLM_MODEL=local-model
# EVE_WEB_SEARXNG_URL=http://127.0.0.1:8888
# EVE_STT_MODEL=small
# EVE_PIPER_VOICE=de_DE-eve-medium
# EVE_PIPER_DATA_DIR=voices
# EVE_STORAGE_DATA_PATH=/mnt/eve-assets
# EVE_STORAGE_CACHE_PATH=/fast-local-cache/eve
# Optionaler Schlüssel des separat konfigurierten Bildservers
EVE_IMAGE_API_KEY=
